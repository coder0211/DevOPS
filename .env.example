# =============================================================================
# DevOPS VPS Manager — Environment Variables
# Copy file này thành .env và điền giá trị thực vào
# cp .env.example .env
# =============================================================================

# ─── Backend ──────────────────────────────────────────────────────────────────

# Môi trường chạy: debug | release | test
GIN_MODE=release

# Thư mục lưu SQLite database (dùng cho Docker volume)
# Khi chạy local không cần set, sẽ dùng ./backend/devops.db
DATA_DIR=/app/data

# Port của backend API
BACKEND_PORT=8080

# ─── Frontend ─────────────────────────────────────────────────────────────────

# Port của frontend (Nginx trong Docker)
FRONTEND_PORT=3000

# ─── SSH ──────────────────────────────────────────────────────────────────────

# Thư mục chứa SSH private keys trên máy host
# Được mount vào container backend để kết nối VPS
# Mặc định: ~/.ssh
SSH_KEY_DIR=~/.ssh
